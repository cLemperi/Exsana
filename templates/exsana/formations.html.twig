{% extends 'base.html.twig' %}

{% block title %}Développez votre expertise - Exsana
{% endblock %}
{% block meta_description %}Apprenez des compétences recherchées grâce à nos formations santé{% endblock %}
{% block meta_keywords %}formations santé, formation urgence, compétences médicales, formations professionnelles santé, expertise santé{% endblock %}
{% block canonical_url %}{{ app.request.uri }}
{% endblock %}
{% block body %}

  <div class="container-fluid background-formation">
    <div class="formation-core container">
      <div class="py-5">
        <div class="title_formation">
          <h1>Formations Exsana Santé<h1></div>
          </div>
          <!-- <br><br> <div class="col-md-3 order-md-2 mb-4"> <h4 class="d-flex justify-content-between align-items-center mb-3"> <span class="title-category">Recherche</span> </h4> {# {% include 'formation/_filter.html.twig' with {form: form} only %} #} </div> <div class="count"> </div> -->
          <div class="listFormations">
            <section class="formations-list">
              {% for formation in formations %}
                <article class="formation-card">
                  {% if formation.externalLink %}
                    <a class="formation-card__link" href="{{ formation.externalLink }}">
                    {% else %}
                      <div class="formation-card__link">
                      {% endif %}
                      <div class="formation-card__content">
                        <h2 class="formation-card__title">{{ formation.title }}</h2>

                        <div class="formation-card__meta">
                          <div class="formation-card__meta-item">
                            <span class="formation-card__label">Durée</span>
                            <span class="formation-card__value">{{ formation.durationFormation }}</span>
                          </div>

                          <div class="formation-card__meta-item">
                            <span class="formation-card__label">Lieu</span>
                            <span class="formation-card__value">{{ formation.location }}</span>
                          </div>
                        </div>
                      </div>
                    </a>
                  </article>
                {% endfor %}
              </section>

              <div class="pagination-wrapper">
                {{ knp_pagination_render(formations, 'pagination/knp_exsana.html.twig') }}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endblock %}
