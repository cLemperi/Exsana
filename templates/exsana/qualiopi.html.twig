{% extends 'base.html.twig' %}

{% block title %}Certification Qualiopi | Exsana{% endblock %}

{% block body %}
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <h1 class="text-center mb-4">Certification Qualiopi</h1>

      <p class="text-center mb-4">
        La société <strong>Exsana</strong> est certifiée Qualiopi au titre de la
        catégorie d’action suivante :
        <strong>ACTIONS DE FORMATION</strong>.
      </p>

      {# PDF affiché directement #}
      <div class="pdf-container">
        <iframe
          src="{{ asset('documents/Certificat_F3512.pdf') }}"
          width="100%"
          height="900"
          style="border: none;"
          title="Certificat Qualiopi Exsana"
        ></iframe>
      </div>

    </div>
  </div>
</div>
{% endblock %}
